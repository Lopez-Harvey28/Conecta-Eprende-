# Database
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/conecta_emprende"
POSTGRES_DB="conecta_emprende"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changeme"
POSTGRES_PORT="5432"

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_SECRET="your-jwt-secret-min-32-chars-here"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars-here"

# Token Expiry
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# OAuth Google (get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"
APP_PORT="3000"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

